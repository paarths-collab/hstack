BUFFER_API_KEY=

# Optional social package connections. Blank values mean disabled.
# Pallyy: official MCP, including Free; key scopes still apply.
PALLYY_API_KEY=
# Metricool: this header-key route requires Advanced/Custom API access.
# Catalogue tools are blocked until exact read names are reviewed; OAuth is pending.
METRICOOL_API_KEY=
# Blotato: paid MCP/API only. Creating a key during trial starts billing.
BLOTATO_API_KEY=
# Ayrshare: eligible API account required. X BYO credentials are not wired yet.
AYRSHARE_API_KEY=

# All writes/unreviewed operations stay blocked unless explicitly enabled.
# HSTACK_ALLOW_BUFFER_WRITES=true
# HSTACK_ALLOW_PALLYY_WRITES=true
# HSTACK_ALLOW_BLOTATO_WRITES=true
# HSTACK_ALLOW_AYRSHARE_WRITES=true

# Optional compact discovery: expose search/call controls instead of every tool.
# HSTACK_TOOL_MODE=search

# Optional native OAuth state/configuration overrides (absolute private paths).
# HSTACK_STATE_DIR=/absolute/path/to/private-auth-directory
# HSTACK_CONNECTIONS_FILE=/absolute/path/to/connections.json

# Optional native BambooHR profile; account/admin approval and a registered app required.
# BAMBOOHR_MCP_URL=https://your-company.bamboohr.com/api/mcp
# BAMBOOHR_MCP_ISSUER=
# BAMBOOHR_MCP_CLIENT_ID=
# BAMBOOHR_MCP_CLIENT_SECRET=
# BAMBOOHR_MCP_SCOPES="mcp employees offline_access"

# Optional native Greenhouse profile; a Site Admin must approve Hstack's callback.
# GREENHOUSE_MCP_URL=https://mcp.us.greenhouse.io/mcp

# Optional native Xero hosted profile; register your own eligible PKCE app first.
# Starter is demo-only; real organisations require Core or above. No client secret.
# XERO_MCP_CLIENT_ID=

# Optional native Typeform profile; host your public CIMD JSON first (no secrets).
# Choose the endpoint/issuer pair for your account. See integrations/typeform/README.md.
# TYPEFORM_MCP_URL=https://api.typeform.com/mcp
# TYPEFORM_MCP_ISSUER=https://api.typeform.com
# TYPEFORM_MCP_CLIENT_METADATA_URL=https://your-public-host.example/oauth/client-metadata.json

# Optional native HubSpot CRM MCP; dedicated connector/auth app and callback required.
# HUBSPOT_MCP_CLIENT_ID=
# HUBSPOT_MCP_CLIENT_SECRET=

# Optional Brevo token: generate with the MCP option, not a normal SMTP/API key.
# BREVO_MCP_TOKEN=
# Optional PagerDuty REST API token (read-only when available); paste the bare value.
# PAGERDUTY_MCP_TOKEN=
# Optional Deel PAT alternative only. The default candidate uses native OAuth.
# DEEL_MCP_TOKEN=

# Optional pinned Google Analytics runtime; see integrations/google-analytics/README.md.
# HSTACK_ANALYTICS_PYTHON=/absolute/path/to/hstack/.hstack-tools/analytics/bin/python
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/private/application_default_credentials.json
# GOOGLE_CLOUD_PROJECT=

# Optional native BigQuery adapter; private owner-only Google credential file.
# Uses an explicit authorized_user/service_account JSON, not implicit ADC lookup.
# Keep the bundled connection disabled until real account/IAM validation.
# BIGQUERY_GOOGLE_CREDENTIALS_FILE=/absolute/path/to/private-google/credentials.json

# Optional unverified Snowflake native HTTP candidate; keep disabled.
# Account/server object and registered OAuth integration required. See its guide.
# SNOWFLAKE_MCP_URL=https://your-account.snowflakecomputing.com/api/v2/databases/YOUR_DB/schemas/YOUR_SCHEMA/mcp-servers/YOUR_SERVER
# SNOWFLAKE_MCP_ISSUER=https://your-account.snowflakecomputing.com
# SNOWFLAKE_MCP_CLIENT_ID=
# SNOWFLAKE_MCP_CLIENT_SECRET=
# SNOWFLAKE_MCP_SCOPES="refresh_token session:role:YOUR_MCP_ROLE"

# Optional MySQL compatibility build; see integrations/mysql/README.md.
# HSTACK_MYSQL_TOOLBOX=/absolute/path/to/hstack/.hstack-tools/toolbox/toolbox-mysql-1.15.0
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_DATABASE=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_QUERY_PARAMS='{"tls":"true"}'

# Optional pinned community Zendesk runtime; see integrations/zendesk/README.md.
# HSTACK_ZENDESK_PYTHON=/absolute/path/to/hstack/.hstack-tools/zendesk/bin/python
# HSTACK_ZENDESK_HOME=/absolute/path/to/private-zendesk-home
# ZENDESK_MCP_READ_ONLY=true

# Optional custom profile references (see docs/connections.md).
# MY_SERVICE_MCP_URL=https://vendor.example/mcp
# MY_SERVICE_MCP_EXECUTABLE=/absolute/path/to/installed-vendor-mcp

# Optional pinned community Mailchimp profile; see integrations/mailchimp/README.md.
# HSTACK_MAILCHIMP_PYTHON=/absolute/path/to/hstack/.hstack-tools/mailchimp/bin/python
# MAILCHIMP_API_KEY=
# MAILCHIMP_READ_ONLY=true
# MAILCHIMP_MAX_RETRIES=0

# Optional pinned official MongoDB profile; see integrations/mongodb/README.md.
# HSTACK_MONGODB_COMMAND=/absolute/path/to/hstack/integrations/mongodb/node_modules/.bin/mongodb-mcp-server
# MDB_MCP_CONNECTION_STRING=

# Optional Redis profile. Set only when configuring an existing database.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PWD=
# REDIS_SSL=false
