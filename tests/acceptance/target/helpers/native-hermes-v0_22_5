#!/usr/bin/env python3
"""Offline CLI fixture for the narrow tagged v0.22.5 surface, NOT real Hermes.

Uses the actual structured jobs.json layout and public argument forms; it deliberately
does not implement legacy TSV output, and rejects `gateway run --daemon` like argparse (exit 2). Separate upstream smoke
checks are required before claiming runtime compatibility.
"""
import argparse
import json
import os
from pathlib import Path
import sys

args = sys.argv[1:]
if args == ["--version"]:
    # Real format (hermes_cli/_startup_fast.py print_fast_version_info): banner, then unrelated x.y.z lines.
    print("Hermes Agent v0.22.5 (2026.9.24) \u00b7 upstream bf0203a7\nInstall directory: /home/operator/.hermes/hermes-agent\n"
          "Install method: git\nPython: 3.11.16\nOpenAI SDK: 2.24.0")
    raise SystemExit(0)
if args[:2] != ["--profile", "default"]:
    raise SystemExit(90)
args = args[2:]
home = Path(os.environ["HERMES_HOME"])
if home.resolve() != (Path(os.environ["HOME"]) / ".hermes").resolve():
    raise SystemExit(91)
if os.environ.get("HSTACK_STUB_LOG"):
    with open(os.environ["HSTACK_STUB_LOG"], "a") as out:
        out.write("\t".join(sys.argv[1:]) + "\n")
if args[:1] == ["cron"]:
    store = home / "cron" / "jobs.json"
    data = json.loads(store.read_text()) if store.exists() else {"jobs": []}
    if args[1] in os.environ.get("HSTACK_NATIVE_FAIL", "").split(","):
        raise SystemExit(1)
    if args[1] == "create":
        # Match the tagged public argparse boundary, including '--' and equals
        # options, so option-looking values are not silently accepted by a stub.
        parser = argparse.ArgumentParser(prog="hermes cron create")
        parser.add_argument("schedule")
        parser.add_argument("prompt", nargs="?")
        parser.add_argument("--skill", dest="skills", action="append")
        parser.add_argument("--paused", action="store_true")
        for name in ("name", "deliver", "model", "provider", "reasoning-effort", "failure-deliver", "paused-reason", "interpreter"):
            parser.add_argument("--" + name)
        options = vars(parser.parse_args(args[2:]))
        schedule, prompt = options.pop("schedule"), options.pop("prompt") or ""
        # Tagged cron.jobs.parse_schedule/create_job normalization. Keep this
        # fixture source-faithful so adapter round-trip bugs cannot pass a stub
        # that preserves values the real CLI would normalize.
        schedule, prompt = schedule.strip(), prompt.strip()
        skills = list(dict.fromkeys(value.strip() for value in options.pop("skills") or [] if value.strip()))
        sequence = home / "cron" / "fixture-sequence"
        n = int(sequence.read_text()) + 1 if sequence.exists() else 1
        store.parent.mkdir(parents=True, exist_ok=True)
        sequence.write_text(str(n))
        paused = options.pop("paused", False)
        for key in ("model", "provider", "failure_deliver", "interpreter"):
            if options.get(key) is not None:
                options[key] = options[key].strip() or None
        if options.get("reasoning_effort") is not None:
            effort = options["reasoning_effort"].strip().lower()
            options["reasoning_effort"] = "none" if effort in {"false", "disabled"} else effort or None
        name = options.pop("name", None) or (prompt or (skills[0] if skills else "cron job"))[:50].strip()
        paused_reason = (options.pop("paused_reason", None) or "").strip() or "Created paused; awaiting operator approval."
        job = dict(id="native-{}".format(n), name=name, prompt=prompt,
                   skills=skills, skill=skills[0] if skills else None,
                   schedule={"kind": "cron", "expr": schedule}, repeat={"times": None, "completed": 0},
                   enabled=not paused, state="paused" if paused else "scheduled",
                   paused_reason=paused_reason if paused else None,
                   paused_at="2026-10-23T00:00:00Z" if paused else None, no_agent=False,
                   created_at="2026-10-23T00:00:00Z", next_run_at="2026-10-24T09:00:00Z",
                   deliver=(options.pop("deliver") or "local").strip() or "local", **options)
        data["jobs"].append(job)
    elif args[1] == "remove" and len(args) == 3:
        old = len(data["jobs"])
        data["jobs"] = [job for job in data["jobs"] if job["id"] != args[2]]
        if len(data["jobs"]) == old:
            raise SystemExit(1)
    else:
        raise SystemExit(92)
    store.write_text(json.dumps(data))
elif args[:1] == ["gateway"] and len(args) >= 2 and args[1] in ("stop", "start", "restart", "ensure", "run"):
    # Option grammar copied from the v0.22.5 parsers (hermes_cli/subcommands/gateway.py:70-155). An undeclared
    # option, notably the nonexistent `run --daemon`, is an argparse usage error: exit 2, like the real CLI.
    parser = argparse.ArgumentParser(prog="hermes gateway " + args[1])
    if args[1] == "stop":
        parser.add_argument("--system", action="store_true"); parser.add_argument("--all", action="store_true")
        parser.add_argument("-y", "--yes", "--interrupt", dest="interrupt", action="store_true")
    elif args[1] == "restart":
        parser.add_argument("--system", action="store_true"); parser.add_argument("--all", action="store_true")
        parser.add_argument("--force", action="store_true"); parser.add_argument("--detach", action="store_true")
        parser.add_argument("-y", "--yes", "--interrupt", dest="interrupt", action="store_true")
    elif args[1] == "start":
        parser.add_argument("--system", action="store_true"); parser.add_argument("--all", action="store_true")
        parser.add_argument("--force", action="store_true")
    elif args[1] == "ensure":
        parser.add_argument("--json", action="store_true"); parser.add_argument("--timeout", default="60")
    else:
        for flag in ("-v", "-q", "--replace", "--force", "--no-supervise", "--external-supervisor", "--accept-hooks"):
            parser.add_argument(flag, action="store_true")
    options = parser.parse_args(args[2:])
    if args[1] == "run":
        raise SystemExit(93)  # the foreground gateway; a script must never call it, so it is not modelled
    if args[1] in os.environ.get("HSTACK_NATIVE_FAIL", "").split(","):
        raise SystemExit(1)
    # Gateway process model: every real restart starts a new process with a fresh instance_id (uuid4 per process,
    # gateway/run_runtime.py:144). Knobs: HSTACK_NATIVE_LIVE_SESSIONS=1 refuses a non-interactive restart without -y
    # (gateway_lifecycle_guards.py:97-132); HSTACK_NATIVE_RESTART_NOOP=1 exits 0 without restarting (linger case,
    # gateway.py:5499-5513); HSTACK_NATIVE_ENSURE_PENDING=N answers the first N `ensure` calls with exit 5 (pending).
    # The first two also exist as marker files (fixture-live-sessions, fixture-restart-noop) so a test can switch them
    # on after apply.
    instance_file = home / "fixture-instance"
    instance = int(instance_file.read_text()) if instance_file.exists() else 1
    if args[1] == "restart":
        if (os.environ.get("HSTACK_NATIVE_LIVE_SESSIONS") == "1" or (home / "fixture-live-sessions").exists()) and not options.interrupt:
            print("Refusing to restart the gateway: 2 live session(s) would be interrupted.")
            raise SystemExit(1)
        if os.environ.get("HSTACK_NATIVE_RESTART_NOOP") != "1" and not (home / "fixture-restart-noop").exists():
            instance_file.write_text(str(instance + 1))
    if args[1] == "ensure":
        commit = os.environ["HSTACK_NATIVE_COMMIT"]
        pending = int(os.environ.get("HSTACK_NATIVE_ENSURE_PENDING", "0"))
        pending_file = home / "fixture-pending"
        done = int(pending_file.read_text()) if pending_file.exists() else 0
        state, code = "ready", 0
        if options.timeout == "60" and done < pending:
            pending_file.write_text(str(done + 1))
            state, code = "pending", 5
        print(json.dumps({"state": state, "client_code_sha": commit, "endpoint": {
            "profile_id": str(home), "control_home": str(home), "supervisor": "systemd",
            "runtime_protocol": 1, "authority_epoch": 1, "instance_id": "fixture-owner-%d" % instance,
            "code_sha": commit,
        }}))
        raise SystemExit(code)
else:
    raise SystemExit(93)
