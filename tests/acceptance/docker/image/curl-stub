#!/usr/bin/env bash
# TEST DOUBLE of curl for the Telegram skill: answers ONLY `getMe`, only for the fake "good" token in
# $HSTACK_FAKE_GOOD_TOKEN, and never touches the network. Everything else fails like an unreachable host.
# The token is read from the curl config on stdin (`--config -`), as the skill sends it. The log records
# argv and the token LENGTH, never the token.
set -u
LOG=/var/tmp/hstack/curl.log
mkdir -p /var/tmp/hstack 2>/dev/null || true
cfg=""
if printf '%s\n' "$*" | grep -q -- '--config -'; then cfg=$(cat); fi
url=$(printf '%s\n' "$cfg" | sed -n 's/^url *= *"\(.*\)".*$/\1/p' | head -1)
tok=${url#https://api.telegram.org/bot}
case "$url" in
  https://api.telegram.org/bot*/getMe)
    tok=${tok%/getMe}
    dollar=0; case "$tok" in *'$'*) dollar=1 ;; esac
    if [ -n "${HSTACK_FAKE_GOOD_TOKEN:-}" ] && [ "$tok" = "$HSTACK_FAKE_GOOD_TOKEN" ]; then verdict=200; else verdict=401; fi
    printf 'argv=%s endpoint=getMe token_len=%s has_dollar=%s verdict=%s\n' "$*" "${#tok}" "$dollar" "$verdict" >> "$LOG"
    if [ "$verdict" = 200 ]; then
      printf '{"ok":true,"result":{"id":424242,"is_bot":true,"first_name":"Fake","username":"hstack_fake_bot"}}\n'
      exit 0
    fi
    printf 'curl: (22) The requested URL returned error: 401\n' >&2
    exit 22 ;;
  *)
    printf 'argv=%s endpoint=other\n' "$*" >> "$LOG"
    printf 'curl: (6) Could not resolve host (test double)\n' >&2
    exit 6 ;;
esac
