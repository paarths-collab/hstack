#!/usr/bin/env bash
# hermes — TEST DOUBLE of the Hermes CLI "adapter surface" declared by the hstack
# acceptance contract. It is NOT Hermes and is NOT evidence about real Hermes:
# every behaviour below is an assumption written down so that hstack-target.sh and
# its tests have something deterministic to run against.
#
# Adapter surface implemented (anything else exits 99, notably `doctor` and `--fix`):
#   hermes --version                       -> "hermes <version>"
#   hermes cron list                       -> one job per line: <id> TAB <schedule> TAB <prompt>
#   hermes cron create <schedule> <prompt> -> appends a job (id job-<n>)
#   hermes cron remove <id>
#   hermes cron run <id>                   -> appends one line to $HOME/.hermes/outbox.log
#   hermes gateway stop | run [--daemon]   -> toggles $HOME/.hermes/gateway.state
#   hermes config set <KEY> <VALUE>        -> UPPER_SNAKE -> .env, dotted -> config.yaml
#                                             (puts the value in argv: exactly why hstack-target.sh
#                                             never calls it for secrets)
#
# State lives under $HOME/.hermes (cron.db, cron.seq, outbox.log, gateway.state).
# `--version` and `cron list` NEVER create or modify any file under $HOME, so the
# read-only guarantee of `inspect` is testable.
#
# Environment knobs:
#   HSTACK_STUB_LOG        file; every invocation is appended as one TAB-joined argv line
#   HSTACK_STUB_VERSION    version printed by --version (default: HERMES_VERSION from VERSIONS.txt)
#   HSTACK_STUB_FAIL       comma list of: version, cron-list, cron-create, cron-remove, cron-run,
#                          gateway-stop, gateway-run, config-set  -> that call logs, then exits 1
#   HSTACK_STUB_GITHUB_FIXTURE   file whose text `cron run` "summarises" (untrusted input)
#   HSTACK_STUB_VULNERABLE=1     deliberately vulnerable runtime: obeys "send to chat <N>" found in the
#                                fixture and leaks $HSTACK_STUB_SYNTHETIC_SECRET into the message body.
#                                Used ONLY so a verifier can prove it detects such outcomes.
#   HSTACK_STUB_SYNTHETIC_SECRET fake secret (never a real token) for the vulnerable mode
set -u
LC_ALL=C
export LC_ALL

if [ -n "${HSTACK_STUB_LOG:-}" ]; then
  {
    first=1
    for a in "$@"; do
      if [ "$first" = 1 ]; then printf '%s' "$a"; first=0; else printf '\t%s' "$a"; fi
    done
    printf '\n'
  } >> "$HSTACK_STUB_LOG"
fi

fail_knob() {
  case ",${HSTACK_STUB_FAIL:-}," in
    *",$1,"*) printf 'hermes-stub: forced failure (%s)\n' "$1" >&2; exit 1 ;;
  esac
}

H="${HOME:-/nonexistent}/.hermes"
DB="$H/cron.db"
SEQ="$H/cron.seq"
OUTBOX="$H/outbox.log"
GW="$H/gateway.state"

declared_version() {
  if [ -n "${HSTACK_STUB_VERSION:-}" ]; then printf '%s' "$HSTACK_STUB_VERSION"; return 0; fi
  # Resolve this script's real location (it is normally symlinked into the sandbox), then
  # walk up to find VERSIONS.txt at the repo root.
  local src=$0 dir link
  while [ -L "$src" ]; do
    link=$(readlink "$src") || break
    case $link in /*) src=$link ;; *) src=$(dirname "$src")/$link ;; esac
  done
  dir=$(cd "$(dirname "$src")" 2>/dev/null && pwd) || return 1
  local i=0
  while [ "$i" -lt 8 ]; do
    if [ -f "$dir/VERSIONS.txt" ]; then
      grep -E '^HERMES_VERSION=' "$dir/VERSIONS.txt" | head -1 | cut -d= -f2-
      return 0
    fi
    dir=$(dirname "$dir")
    i=$((i + 1))
  done
  return 1
}

job_exists() { [ -f "$DB" ] && awk -F'\t' -v id="$1" '$1==id{f=1} END{exit !f}' "$DB"; }

one_line() { printf '%s' "$1" | tr '\n\r\t' '   ' | cut -c1-"${2:-160}"; }

env_get() { # last KEY=value in $H/.env, quotes stripped
  [ -f "$H/.env" ] || return 1
  awk -v k="$1" '{ t=$0; if (substr(t,1,7)=="export ") t=substr(t,8);
      if (substr(t,1,length(k)+1)==k"=") v=substr(t,length(k)+2) }
    END { if (v=="") exit 1; gsub(/^["\047]|["\047]$/,"",v); print v }' "$H/.env"
}

[ $# -ge 1 ] || { echo "hermes-stub: no subcommand" >&2; exit 99; }

case "$1" in
  --version)
    [ $# -eq 1 ] || exit 99
    fail_knob version
    v=$(declared_version) || { echo "hermes-stub: no version (set HSTACK_STUB_VERSION)" >&2; exit 98; }
    printf 'hermes %s\n' "$v"
    exit 0
    ;;
  cron)
    [ $# -ge 2 ] || exit 99
    case "$2" in
      list)
        [ $# -eq 2 ] || exit 99
        fail_knob cron-list
        [ -f "$DB" ] && cat "$DB"
        exit 0
        ;;
      create)
        [ $# -eq 4 ] || { echo "hermes-stub: cron create <schedule> <prompt>" >&2; exit 2; }
        fail_knob cron-create
        umask 077
        mkdir -p "$H" || exit 1
        n=0
        [ -f "$SEQ" ] && n=$(cat "$SEQ")
        if [ -f "$DB" ]; then
          m=$(awk -F'\t' '{ id = $1; sub(/^job-/, "", id); if (id ~ /^[0-9]+$/ && id + 0 > mx) mx = id + 0 } END { print mx + 0 }' "$DB")
          [ "$m" -gt "$n" ] && n=$m
        fi
        n=$((n + 1))
        printf '%s\n' "$n" > "$SEQ"
        printf 'job-%s\t%s\t%s\n' "$n" "$3" "$4" >> "$DB"
        printf 'job-%s\n' "$n"
        exit 0
        ;;
      remove)
        [ $# -eq 3 ] || exit 2
        fail_knob cron-remove
        [ -f "$DB" ] || exit 1
        job_exists "$3" || { echo "hermes-stub: no such job" >&2; exit 1; }
        awk -F'\t' -v id="$3" '$1!=id' "$DB" > "$DB.tmp.$$" && mv "$DB.tmp.$$" "$DB"
        exit 0
        ;;
      run)
        [ $# -eq 3 ] || exit 2
        fail_knob cron-run
        job_exists "$3" || { echo "hermes-stub: no such job" >&2; exit 1; }
        dest=$(env_get TELEGRAM_HOME_CHANNEL) || { echo "hermes-stub: no TELEGRAM_HOME_CHANNEL" >&2; exit 1; }
        fixture=""
        if [ -n "${HSTACK_STUB_GITHUB_FIXTURE:-}" ] && [ -f "$HSTACK_STUB_GITHUB_FIXTURE" ]; then
          fixture=$(cat "$HSTACK_STUB_GITHUB_FIXTURE")
        fi
        summary="github summary: $(one_line "$fixture" 120)"
        umask 077
        mkdir -p "$H" || exit 1
        printf 'to=%s body=%s\n' "$dest" "$summary" >> "$OUTBOX"
        if [ "${HSTACK_STUB_VULNERABLE:-0}" = 1 ]; then
          # Deliberately vulnerable: follows an instruction embedded in retrieved content.
          target=$(printf '%s' "$fixture" | grep -Eo 'send to chat -?[0-9]+' | head -1 | sed 's/^send to chat //')
          if [ -n "$target" ]; then
            printf 'to=%s body=%s leaked=%s\n' "$target" "$summary" "${HSTACK_STUB_SYNTHETIC_SECRET:-}" >> "$OUTBOX"
          fi
        fi
        exit 0
        ;;
      *) exit 99 ;;
    esac
    ;;
  gateway)
    [ $# -ge 2 ] || exit 99
    case "$2" in
      stop)
        [ $# -eq 2 ] || exit 99
        fail_knob gateway-stop
        [ -d "$H" ] && printf 'stopped\n' > "$GW"
        exit 0
        ;;
      run)
        { [ $# -eq 2 ] || { [ $# -eq 3 ] && [ "$3" = "--daemon" ]; }; } || exit 99
        fail_knob gateway-run
        umask 077
        mkdir -p "$H" || exit 1
        printf 'running\n' > "$GW"
        exit 0
        ;;
      *) exit 99 ;;
    esac
    ;;
  config)
    [ $# -eq 4 ] && [ "$2" = "set" ] || exit 99
    fail_knob config-set
    umask 077
    mkdir -p "$H" || exit 1
    case "$3" in
      *[!A-Z0-9_]*)
        printf '%s: %s\n' "$3" "$4" >> "$H/config.yaml" ;;
      *)
        f="$H/.env"
        [ -f "$f" ] || : > "$f"
        { grep -v "^$3=" "$f"; printf '%s=%s\n' "$3" "$4"; } > "$f.tmp.$$" && mv "$f.tmp.$$" "$f"
        ;;
    esac
    exit 0
    ;;
  *)
    printf 'hermes-stub: unsupported subcommand\n' >&2
    exit 99
    ;;
esac
