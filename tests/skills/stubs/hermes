#!/bin/bash
# Test double of the Hermes CLI "adapter surface" the skills call. It is NOT Hermes and is not evidence
# about the real CLI: each behaviour below is an assumption written down so the skill blocks have
# something deterministic to run against. It lives ONLY in $HOME/.local/bin of the simulated VPS, so a
# remote() that forgets to put that directory on PATH cannot find it (as on a real non-login ssh shell).
#
# Surface (anything else logs "unknown" and exits 99):
#   --version
#   config set KEY [--] VALUE   UPPER_SNAKE -> ~/.hermes/.env (upsert), dotted -> ~/.hermes/config.yaml
#   config show                 prints config.yaml
#   mcp add NAME [--command C] [--args A] [--url U] [--env K=V] [--auth-header H] [--auth-scheme S]
#   mcp remove NAME | mcp list  (state is the "mcp.NAME:" blocks of config.yaml)
#   gateway stop | run [--daemon] | start | status | install
#   logs [gateway] [-n N]       prints $HOME/logs.txt (or a default healthy log)
#   -z PROMPT                   prints $HOME/infer.out (default "OK")
#   setup --non-interactive
#   cron list | create SCHEDULE PROMPT | remove ID
#
# New files are created with the ambient umask (like the real CLI would), so the skills must chmod 600
# themselves. Logs: logs/hermes-argv.log (tab-joined argv, includes values), logs/events.log (no values).
# Knobs (empty files under $HOME/knobs):
#   fail.<point>        the call logs, prints an error, exits 1. Points: version, set, set.<KEY>, mcp.add,
#                       mcp.remove, gateway.run, gateway.stop, gateway.install, gateway.status, logs,
#                       infer, setup, cron.create
#   fail.set_nth        file holding N: the Nth `config set` of the run fails
#   strict_negnum       a value like -100123 without `--` before it is rejected as an unknown option
#   quote_env           values are written to .env as KEY="value"
#   inject_allowall     after TELEGRAM_BOT_TOKEN is written, GATEWAY_ALLOW_ALL_USERS="true" is appended
#   status_override     file whose content `gateway status` prints; status_exit holds its exit code
set -u
H=$HOME/.hermes
ENVF=$H/.env
CFG=$H/config.yaml
K=$HOME/knobs
mkdir -p "$H" "$HOME/logs" "$HOME/state"

{
  first=1
  for a in "$@"; do
    if [ "$first" = 1 ]; then printf '%s' "$a"; first=0; else printf '\t%s' "$a"; fi
  done
  printf '\n'
} >> "$HOME/logs/hermes-argv.log"

event() { printf 'hermes %s\n' "$*" >> "$HOME/logs/events.log"; }
inject() {
  if [ -f "$K/fail.$1" ]; then
    echo "hermes: injected failure ($1)" >&2
    exit 1
  fi
}
upsert_env() { # KEY VALUE
  local k=$1 v=$2 line
  [ -f "$ENVF" ] || : > "$ENVF"
  line="$k=$v"
  [ -f "$K/quote_env" ] && line="$k=\"$v\""
  { grep -v "^$k=" "$ENVF" || true; printf '%s\n' "$line"; } > "$ENVF.tmp"
  cat "$ENVF.tmp" > "$ENVF"
  rm -f "$ENVF.tmp"
}
upsert_cfg() { # KEY VALUE
  [ -f "$CFG" ] || : > "$CFG"
  { grep -v "^$1: " "$CFG" || true; printf '%s: %s\n' "$1" "$2"; } > "$CFG.tmp"
  cat "$CFG.tmp" > "$CFG"
  rm -f "$CFG.tmp"
}
mcp_names() { [ -f "$CFG" ] && sed -n 's/^mcp\.\([^:]*\):.*$/\1/p' "$CFG"; }
gw_state() { cat "$H/gateway.state" 2>/dev/null || echo stopped; }

case "${1:-}" in
  --version)
    event --version; inject version
    echo "hermes 0.15.2" ;;
  config)
    case "${2:-}" in
      set)
        shift 2
        dd=0; pos=()
        for a in "$@"; do
          if [ "$dd" = 0 ] && [ "$a" = "--" ]; then dd=1; continue; fi
          if [ "$dd" = 0 ] && [ "${a#-}" != "$a" ]; then
            if [ "$a" = "--force" ]; then continue; fi
            if printf '%s' "$a" | grep -Eq '^-[0-9]+$' && [ ! -f "$K/strict_negnum" ]; then :
            else echo "hermes: error: unrecognized option '$a'" >&2; exit 2; fi
          fi
          pos+=("$a")
        done
        key=${pos[0]:-}; val=${pos[1]:-}
        n=0; [ -f "$HOME/state/set.count" ] && n=$(cat "$HOME/state/set.count")
        n=$((n + 1)); echo "$n" > "$HOME/state/set.count"
        event config set "$key"
        if [ -f "$K/fail.set_nth" ] && [ "$n" = "$(cat "$K/fail.set_nth")" ]; then
          echo "hermes: injected failure (config set #$n)" >&2; exit 1
        fi
        inject set; inject "set.$key"
        if printf '%s' "$key" | grep -Eq '^[A-Z][A-Z0-9_]*$'; then
          upsert_env "$key" "$val"
          if [ -f "$K/inject_allowall" ] && [ "$key" = TELEGRAM_BOT_TOKEN ]; then
            printf 'GATEWAY_ALLOW_ALL_USERS="true"\n' >> "$ENVF"
          fi
        else
          upsert_cfg "$key" "$val"
        fi ;;
      show)
        event config show
        cat "$CFG" 2>/dev/null || true ;;
      *) event unknown "$@"; echo "hermes: unknown: $*" >&2; exit 99 ;;
    esac ;;
  mcp)
    case "${2:-}" in
      add)
        name=${3:-}; shift 3
        event mcp add "$name"; inject mcp.add
        if mcp_names | grep -qxF -- "$name"; then echo "hermes: mcp server '$name' already exists" >&2; exit 1; fi
        {
          echo "mcp.$name:"
          while [ $# -gt 0 ]; do
            case "$1" in
              --command|--args|--url|--env|--auth-header|--auth-scheme|--placeholder-token)
                printf '  %s: %s\n' "${1#--}" "${2:-}"; shift 2 ;;
              *) shift ;;
            esac
          done
        } >> "$CFG" ;;
      remove)
        event mcp remove "${3:-}"; inject mcp.remove
        if [ -f "$CFG" ]; then
          awk -v n="mcp.${3:-}:" '$0==n{skip=1; next} skip && /^[[:space:]]/{next} {skip=0; print}' "$CFG" > "$CFG.tmp"
          cat "$CFG.tmp" > "$CFG"; rm -f "$CFG.tmp"
        fi ;;
      list)
        event mcp list
        mcp_names ;;
      *) event unknown "$@"; echo "hermes: unknown: $*" >&2; exit 99 ;;
    esac ;;
  gateway)
    case "${2:-}" in
      stop)    event gateway stop; inject gateway.stop; echo stopped > "$H/gateway.state" ;;
      run)     event gateway run; inject gateway.run; echo running > "$H/gateway.state" ;;
      start)   event gateway start; echo running > "$H/gateway.state" ;;
      install) event gateway install; inject gateway.install; echo installed >> "$HOME/state/gateway.install" ;;
      status)
        event gateway status; inject gateway.status
        if [ -f "$K/status_override" ]; then
          cat "$K/status_override"
          [ -f "$K/status_exit" ] && exit "$(cat "$K/status_exit")"
        else
          echo "gateway $(gw_state)"
        fi ;;
      *) event unknown "$@"; echo "hermes: unknown: $*" >&2; exit 99 ;;
    esac ;;
  logs)
    event logs; inject logs
    if [ -f "$HOME/logs.txt" ]; then
      cat "$HOME/logs.txt"
    else
      printf "gateway ready\nregistered 3 tool(s) for 'notion'\nregistered tool github\ntelegram connected\nmodel anthropic/claude-sonnet-4 loaded\n"
    fi ;;
  -z)
    event -z; inject infer
    if [ -f "$HOME/infer.out" ]; then cat "$HOME/infer.out"; else echo OK; fi ;;
  setup)
    event setup "${2:-}"; inject setup
    case "${2:-}" in --non-interactive) ;; *) echo "hermes: setup would block on a prompt" >&2; exit 5 ;; esac ;;
  cron)
    db=$H/cron.db
    case "${2:-}" in
      list)   event cron list; [ -f "$db" ] && cat "$db"; true ;;
      create) event cron create; inject cron.create; printf 'job-%s\t%s\t%s\n' "$(($(wc -l < "$db" 2>/dev/null || echo 0) + 1))" "${3:-}" "${4:-}" >> "$db" ;;
      remove) event cron remove; [ -f "$db" ] && { grep -v "^${3:-}	" "$db" > "$db.tmp" || true; cat "$db.tmp" > "$db"; rm -f "$db.tmp"; }; true ;;
      *) event unknown "$@"; echo "hermes: unknown: $*" >&2; exit 99 ;;
    esac ;;
  *)
    event unknown "$@"
    echo "hermes: unknown command: $*" >&2
    exit 99 ;;
esac
exit 0
