  {
    "name": "retrieveAtsJobPostingsByOrganization",
    "title": "retrieveAtsJobPostingsByOrganization",
    "description": "Retrieves a list of all job postings in the Applicant Tracking System. Results can be filtered by query parameters.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "description": "Maximum number of records returned in one response (optional)",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "description": "The cursor for pagination (optional)",
          "type": "string"
        },
        "job_board_id": {
          "description": "Job Board ID must be a valid UUID",
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "Unique identifier of the organization"
        }
      },
      "required": [
        "organization_id"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ],
      "com.deel/lifecycle": "stable",
      "com.deel/apiVersion": "2026-01-01"
    }
