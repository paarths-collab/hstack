[
  {
    "name": "eor_employment_cost_batch",
    "title": "eor_employment_cost_batch",
    "description": "Determine the total employment costs for an Employee of Record (EOR) arrangement across different countries, including salary, employer costs, benefits, and additional fees.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "description": "The state or region within the country, if applicable."
              },
              "salary": {
                "type": "number",
                "minimum": 1,
                "description": "The base salary for the employee."
              },
              "currency": {
                "type": "string",
                "description": "The currency in which the costs are calculated."
              },
              "country_code": {
                "type": "string",
                "description": "The two-letter country code where the employee is based."
              },
              "country_name": {
                "type": "string",
                "description": "The country where the employee is based."
              },
              "salary_period": {
                "type": "string",
                "enum": [
                  "ANNUALLY",
                  "MONTHLY"
                ],
                "description": "The salary_period frequency in uppercase format."
              },
              "payment_frequency": {
                "type": "string",
                "enum": [
                  "ANNUALLY",
                  "MONTHLY",
                  "WEEKLY",
                  "DAILY"
                ],
                "description": "The payment_frequency of the salary payment."
              }
            },
            "required": [
              "salary",
              "currency",
              "country_name"
            ],
            "additionalProperties": {}
          },
          "description": "Array of employee cost calculation requests."
        }
      },
      "required": [
        "data"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ],
      "com.deel/lifecycle": "stable",
      "com.deel/apiVersion": "2026-01-01"
    }
  },
  {
    "name": "eor_employment_cost_calculate",
    "title": "eor_employment_cost_calculate",
    "description": "Calculates the total employment cost for an EOR arrangement in a specified country, returning a breakdown that includes employer costs, benefits, platform fees, and severance accrual.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "description": "The state or region within the country, if applicable."
            },
            "salary": {
              "type": "number",
              "minimum": 1,
              "description": "The base salary for the employee."
            },
            "country": {
              "type": "string",
              "description": "The full name of the country where the employee is based."
            },
            "benefits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "plan_id": {
                    "type": "string",
                    "description": "The ID of the benefits plan, if applicable."
                  },
                  "provider_id": {
                    "type": "string",
                    "description": "The ID of the benefits provider."
                  }
                },
                "required": [
                  "provider_id"
                ],
                "additionalProperties": {}
              },
              "description": "A list of selected benefit plans for the employee."
            },
            "currency": {
              "type": "string",
              "description": "The currency in which the costs are calculated."
            },
            "country_code": {
              "type": "string",
              "description": "The two-letter country code where the employee is based."
            },
            "salary_period": {
              "type": "string",
              "enum": [
                "ANNUALLY",
                "MONTHLY"
              ],
              "description": "The salary period for the amount provided."
            }
          },
          "required": [
            "salary",
            "country",
            "currency"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "data"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ],
      "com.deel/lifecycle": "stable",
      "com.deel/apiVersion": "2026-01-01"
    }
  },
  {
