  {
    "name": "hiring_insights_salary_calculate",
    "title": "hiring_insights_salary_calculate",
    "description": "Use this endpoint to retrieve a salary histogram for a specified job title and seniority level in a given country, returned in the requested currency and time scale.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scale": {
                "type": "string",
                "enum": [
                  "ANNUALLY",
                  "MONTHLY"
                ],
                "description": "The time scale for the salary data"
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$",
                "description": "Two-letter country code (ISO 3166-1 alpha-2)"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "Three-letter currency code (ISO 4217)"
              },
              "job_title": {
                "type": "string",
                "description": "The job title for the salary data"
              },
              "seniority_level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Seniority level (typically 1-5 or similar scale)"
              }
            },
            "required": [
              "scale",
              "country",
              "currency",
              "job_title",
              "seniority_level"
            ],
            "additionalProperties": {}
          },
          "description": "Array of salary data requests"
        }
      },
      "required": [
        "data"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ],
      "com.deel/lifecycle": "stable",
      "com.deel/apiVersion": "2026-01-01"
    }
  },
  {
    "name": "hiring_insights_summary_get",
    "title": "hiring_insights_summary_get",
    "description": "Provides the best countries to hire talent based on your criteria, so you can make informed, strategic hiring decisions with confidence.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "budget": {
          "description": "Budget limit for the position",
          "type": "number"
        },
        "regions": {
          "description": "Geographic regions to filter by",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "EMEA",
              "APAC",
              "NA",
              "LATAM",
              "MENA",
              "SSA",
              "SEA",
              "CA",
              "EU",
              "ALL"
            ]
          }
        },
        "job_title": {
          "type": "string",
          "description": "The job title for which you want to get hiring insights"
        },
        "seniority": {
          "type": "string",
          "enum": [
            "JUNIOR",
            "MIDDLE",
            "SENIOR"
          ],
          "description": "The seniority level of the position"
        },
        "timezones": {
          "description": "Timezone offsets to filter by",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "-12:00",
              "-11:00",
              "-10:00",
              "-09:00",
              "-08:00",
              "-07:00",
              "-06:00",
              "-05:00",
              "-04:00",
              "-03:00",
              "-02:00",
              "-01:00",
              "+00:00",
              "+01:00",
              "+02:00",
              "+03:00",
              "+04:00",
              "+05:00",
              "+06:00",
              "+07:00",
              "+08:00",
              "+09:00",
              "+10:00",
              "+11:00",
              "+12:00",
              "+13:00",
              "+14:00"
            ]
          }
        },
        "budget_type": {
          "description": "Type of budget calculation",
          "type": "string",
          "enum": [
            "GROSS_ANNUAL_SALARY",
            "TOTAL_COST"
          ]
        },
        "priority_factors": {
          "description": "Priority factors to consider when filtering countries",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "HIGHER_TALENT_CONCENTRATION",
              "SAME_TIMEZONE",
              "ALIGNED_WITH_MY_BUDGET",
              "FASTER_SPEED_TO_HIRE"
            ]
          }
        }
      },
      "required": [
        "job_title",
        "seniority"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "title": "hiring_insights_summary_get",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ],
      "com.deel/lifecycle": "stable",
      "com.deel/apiVersion": "2026-01-01"
    }
  },
